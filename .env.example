# Default: DeepSeek's native DSH adapter
NGFI_LLM_PROVIDER=deepseek-official
NGFI_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-with-your-key

# Optional DeepSeek-compatible gateway
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional reasoning level. Leave unset to use the provider default.
# NGFI_REASONING_EFFORT=high

# Optional governed Agent preset: finance-analyst (default), company-research,
# strategy-research, or portfolio-risk.
# NGFI_AGENT_PRESET=finance-analyst

# Optional runtime data root for research, signal, and holdings state.
# Defaults to .runtime/finance-data and must not be a symlink.
# NGFI_RUNTIME_DATA_ROOT=/absolute/path/to/private/runtime/data

# OpenAI alternative:
# NGFI_LLM_PROVIDER=openai
# NGFI_LLM_MODEL=gpt-5
# OPENAI_API_KEY=replace-with-your-key

# Anthropic alternative:
# NGFI_LLM_PROVIDER=anthropic
# NGFI_LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=replace-with-your-key

# Generic OpenAI-compatible endpoint alternative:
# NGFI_LLM_PROVIDER=openai-compatible
# NGFI_LLM_MODEL=your-model-id
# NGFI_LLM_API=openai-completions
# NGFI_LLM_BASE_URL=https://your-gateway.example/v1
# NGFI_API_KEY=replace-with-your-key
# NGFI_CONTEXT_WINDOW=131072
# NGFI_MAX_TOKENS=8192

# Optional Web UI port (default: 3180)
# FINANCE2DSH_PORT=3180

# Optional A-share live providers. Keep real values out of this file and the
# project .env; store only the entries you use in
# .runtime/secrets/a-share-data.env with mode 600. Public A-share data and the
# local CNE6 reader do not require credentials.

# TuShare official MCP (configure a token, an approved URL, or both)
# TUSHARE_MCP_URL=https://api.tushare.pro/mcp/
# TUSHARE_TOKEN=replace-with-your-tushare-token

# TDX official licensed service (the transport remains dormant until verified)
# TDX_DATA_KEY=replace-with-your-tdx-data-key

# TDX-compatible community quote servers (machine-specific, no URL scheme)
# TDX_COMMUNITY_SERVERS=replace-with-approved-host:replace-with-port

# iFinD official MCP (the adapter remains dormant until a live handshake is verified)
# IFIND_MCP_URL=https://replace-with-your-approved-ifind-host.example/mcp
# IFIND_MCP_CREDENTIAL=replace-with-your-ifind-credential

# Optional local published CNE6 data root (never point this at staging/checkpoints)
# CNE6_DATA_ROOT=/absolute/path/to/published/cne6/data

# Optional iwencai SkillHub key; the current default runtime does not route this provider
# IWENCAI_API_KEY=replace-with-your-iwencai-key
