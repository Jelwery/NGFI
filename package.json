{
  "name": "ngfi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:ts": "vitest run",
    "test:python": "if [ -f packages/quant-research/pyproject.toml ]; then UV_CACHE_DIR=.uv-cache uv run --project packages/quant-research --frozen python -m unittest discover -s packages/quant-research/tests -v; else echo 'quant-research: not present in this phase'; fi",
    "test:skills": "python -m unittest tests/test_v2_contracts.py -v && python skills/company-financial-analysis/scripts/selftest.py",
    "test:runtime": "pnpm run prepare && pnpm run dump:headless && pnpm run dump:web",
    "capability:check": "node scripts/validate-capability-manifest.mjs",
    "boundaries:check": "node scripts/check-package-boundaries.mjs",
    "preset:check": "node scripts/check-presets.mjs",
    "data:upstream:check": "node scripts/check-upstream-integrity.mjs",
    "security:scan:tracked": "node scripts/security-scan.mjs --tracked",
    "security:scan:staged": "node scripts/security-scan.mjs --staged",
    "security:scan:worktree": "node scripts/security-scan.mjs --worktree",
    "dependency:licenses:check": "node scripts/dependency-audit.mjs --check",
    "dependency:licenses:update": "node scripts/dependency-audit.mjs --update",
    "check:static": "pnpm run capability:check && pnpm run boundaries:check && pnpm run preset:check && pnpm run data:upstream:check && pnpm run dependency:licenses:check && pnpm run security:scan:worktree",
    "sync:cne6": "cd packages/combinatorial-optimization && UV_CACHE_DIR=.uv-cache uv sync --extra dev",
    "cne6:data": "pnpm --dir packages/combinatorial-optimization run cne6:data",
    "cne6:data:probe": "pnpm --dir packages/combinatorial-optimization run cne6:data:probe",
    "cne6:data:rebuild": "pnpm --dir packages/combinatorial-optimization run cne6:data:rebuild",
    "cne6:data:validate": "pnpm --dir packages/combinatorial-optimization run cne6:data:validate",
    "cne6:data:smoke": "pnpm --dir packages/combinatorial-optimization run cne6:data:smoke",
    "test:cne6": "pnpm --dir packages/combinatorial-optimization run test:cne6",
    "test:live:yfinance": "FINANCE2DSH_LIVE=1 vitest run --config vitest.live.config.ts tests/yfinance.live.test.ts",
    "test:live:cne6": "pnpm --dir packages/combinatorial-optimization run test:cne6:live",
    "prepare": "tsx src/runtime.ts prepare",
    "dump:headless": "tsx src/runtime.ts dump finance-headless",
    "dump:web": "tsx src/runtime.ts dump finance-dev",
    "ask": "tsx src/runtime.ts headless",
    "run": "tsx src/runtime.ts headless",
    "web": "tsx src/runtime.ts web",
    "test:e2e": "tsx src/e2e.ts && tsx src/web-smoke.ts",
    "test:e2e:model": "tsx src/e2e.ts",
    "test:e2e:web": "tsx src/web-smoke.ts",
    "check": "node scripts/check-worktree-clean.mjs --record && pnpm run check:static && pnpm run build && pnpm run typecheck && pnpm run test:ts && pnpm run test:python && pnpm run test:cne6 && pnpm run test:skills && pnpm run test:runtime && node scripts/check-worktree-clean.mjs --verify"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@finance2dsh/core": "workspace:*",
    "@finance2dsh/dsh-bundle": "workspace:*",
    "@finance2dsh/dsh-tools": "workspace:*",
    "@finance2dsh/provider-yfinance": "workspace:*",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
