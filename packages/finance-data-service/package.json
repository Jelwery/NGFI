{
  "name": "@finance2dsh/data-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./providers/*": {
      "types": "./lib/providers/*/index.d.ts",
      "import": "./lib/providers/*/index.js"
    }
  },
  "files": ["lib", "providers"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@finance2dsh/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
