{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "packages/finance-core/src/**/*.ts",
    "packages/finance-data-service/src/**/*.ts",
    "packages/research-core/src/**/*.ts",
    "packages/research-workspace/src/**/*.ts",
    "packages/research-audit/src/**/*.ts",
    "packages/research-workflow/src/**/*.ts",
    "packages/strategy-core/src/**/*.ts",
    "packages/technical-analysis/src/**/*.ts",
    "packages/strategy-accumulation-breakout/src/**/*.ts",
    "packages/signal-evaluation/src/**/*.ts",
    "packages/portfolio-risk/src/**/*.ts",
    "packages/finance-provider-astock/src/**/*.ts",
    "packages/finance-provider-cne6/src/**/*.ts",
    "packages/finance-provider-ifind/src/**/*.ts",
    "packages/finance-provider-tdx/src/**/*.ts",
    "packages/finance-provider-tushare-mcp/src/**/*.ts",
    "packages/finance-provider-yfinance/src/**/*.ts",
    "packages/dsh-finance-tools/src/**/*.ts",
    "packages/dsh-finance-bundle/src/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vitest.live.config.ts"
  ]
}

