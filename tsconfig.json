{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "packages/finance-core/src/**/*.ts",
    "packages/finance-provider-yfinance/src/**/*.ts",
    "packages/dsh-finance-tools/src/**/*.ts",
    "packages/dsh-finance-bundle/src/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vitest.live.config.ts"
  ]
}

